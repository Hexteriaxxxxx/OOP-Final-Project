<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controllers.StaffReportsController"
            prefWidth="1100" prefHeight="780" style="-fx-background-color: #f9fafb;">
    <left>
        <VBox prefWidth="160" minWidth="160" style="-fx-background-color: #8B0000;">
            <VBox style="-fx-padding: 14 12 14 12; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 0 0 1 0;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🛡" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                    <VBox><Label text="Pass Slip" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/><Label text="Issuance System" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 10px;"/></VBox>
                </HBox>
            </VBox>
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 6 0 0 0;">
                <Button text="  ⊞  Dashboard"          maxWidth="Infinity" onAction="#handleDashboard" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12; -fx-border-width: 0; -fx-cursor: hand;"/>
                <Button text="  📋  Pass Slip Issuance" maxWidth="Infinity" onAction="#handlePassSlip"  style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12; -fx-border-width: 0; -fx-cursor: hand;"/>
                <Button text="  📊  Reports"            maxWidth="Infinity"                             style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12; -fx-border-width: 0; -fx-cursor: hand;"/>
            </VBox>
            <VBox style="-fx-padding: 12 12 12 12; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1 0 0 0;">
                <Label fx:id="lblStaffName" text="Staff" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label fx:id="lblStaffRole" text="Staff" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
                <Button text="↪  Logout" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-width: 0; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox style="-fx-background-color: white;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 14 20 12 20; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
                <VBox HBox.hgrow="ALWAYS"><Label text="Reports" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/><Label text="View daily and monthly activity logs" style="-fx-font-size: 12px; -fx-text-fill: #888;"/></VBox>
                <Button fx:id="btnNotification" text="🔔" onAction="#handleNotification" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #888; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 4;"/>
            </HBox>
            <HBox spacing="12" style="-fx-padding: 14 20 0 20;">
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Total Records" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblTotalMonth" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;"/></VBox><Label text="📄" style="-fx-font-size: 22px;"/></HBox></VBox>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Approved Rate" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblApprovedRate" text="0%" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/></VBox><Label text="📈" style="-fx-font-size: 22px;"/></HBox></VBox>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Avg Duration" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblAvgDuration" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/></VBox><Label text="🕐" style="-fx-font-size: 22px;"/></HBox></VBox>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;"><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Pass Slips" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblTotalVisitors" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #BA7517;"/></VBox><Label text="📋" style="-fx-font-size: 22px;"/></HBox></VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 14 20 10 20;">
                <HBox spacing="6" HBox.hgrow="ALWAYS">
                    <ToggleButton fx:id="btnDailyLogs"   text="Daily Logs"   selected="true" onAction="#switchToDaily"   style="-fx-background-color:#8B0000;-fx-text-fill:white;-fx-font-size:13px;-fx-padding:6 18;-fx-background-radius:20;-fx-border-radius:20;-fx-border-width:0;-fx-cursor:hand;"/>
                    <ToggleButton fx:id="btnMonthlyLogs" text="Monthly Logs"              onAction="#switchToMonthly" style="-fx-background-color:white;-fx-text-fill:#555;-fx-font-size:13px;-fx-padding:6 18;-fx-background-radius:20;-fx-border-radius:20;-fx-border-color:#ddd;-fx-border-width:1;-fx-cursor:hand;"/>
                </HBox>
                <Button text="⬇  Export Report" onAction="#handleExport" style="-fx-background-color:#1D9E75;-fx-text-fill:white;-fx-font-size:12.5px;-fx-padding:7 16;-fx-background-radius:20;-fx-border-radius:20;-fx-border-width:0;-fx-cursor:hand;"/>
            </HBox>
            <VBox fx:id="dailySection" VBox.vgrow="ALWAYS" spacing="8" style="-fx-padding: 0 20 20 20;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Filter by:" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-padding: 0 4 0 0;"/>
                    <Button fx:id="btnFilterToday" text="Today"      onAction="#handleFilterToday" style="-fx-background-color:white;-fx-text-fill:#555;-fx-border-color:#ddd;-fx-border-width:1;-fx-background-radius:20;-fx-border-radius:20;-fx-font-size:12px;-fx-padding:5 14;-fx-cursor:hand;"/>
                    <Button fx:id="btnFilterWeek"  text="This Week"  onAction="#handleFilterWeek"  style="-fx-background-color:white;-fx-text-fill:#555;-fx-border-color:#ddd;-fx-border-width:1;-fx-background-radius:20;-fx-border-radius:20;-fx-font-size:12px;-fx-padding:5 14;-fx-cursor:hand;"/>
                    <Button fx:id="btnFilterMonth" text="This Month" onAction="#handleFilterMonth" style="-fx-background-color:white;-fx-text-fill:#555;-fx-border-color:#ddd;-fx-border-width:1;-fx-background-radius:20;-fx-border-radius:20;-fx-font-size:12px;-fx-padding:5 14;-fx-cursor:hand;"/>
                    <Button fx:id="btnFilterAll"   text="All"        onAction="#handleFilterAll"   style="-fx-background-color:#8B0000;-fx-text-fill:white;-fx-border-width:0;-fx-background-radius:20;-fx-border-radius:20;-fx-font-size:12px;-fx-padding:5 14;-fx-cursor:hand;-fx-font-weight:bold;"/>
                    <Button fx:id="btnFilterDate"  text="Pick Date"  onAction="#handleFilterDate"  style="-fx-background-color:white;-fx-text-fill:#555;-fx-border-color:#ddd;-fx-border-width:1;-fx-background-radius:20;-fx-border-radius:20;-fx-font-size:12px;-fx-padding:5 14;-fx-cursor:hand;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="🔍  Search..." onKeyReleased="#handleSearch" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 7 12; -fx-font-size: 12.5px;"/>
                    <ComboBox fx:id="filterStatus" promptText="Filter" onAction="#handleFilter" style="-fx-background-radius: 20; -fx-border-color: #ddd; -fx-background-color: white; -fx-pref-width: 110px;"/>
                </HBox>
                <!-- StackPane for skeleton overlay -->
                <StackPane fx:id="skeletonContainer" VBox.vgrow="ALWAYS">
                    <TableView fx:id="dailyTable" maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: white; -fx-border-color: #e8e8e8;">
                        <columns>
                            <TableColumn fx:id="colRequestId"  text="Request ID"    prefWidth="90"/>
                            <TableColumn fx:id="colDate"       text="Date"          prefWidth="95"/>
                            <TableColumn fx:id="colEmpName"    text="Employee Name" prefWidth="120"/>
                            <TableColumn fx:id="colDepartment" text="Department"    prefWidth="110"/>
                            <TableColumn fx:id="colPurpose"    text="Purpose"       prefWidth="130"/>
                            <TableColumn fx:id="colTimeOut"    text="Time Out"      prefWidth="80"/>
                            <TableColumn fx:id="colTimeIn"     text="Time In"       prefWidth="80"/>
                            <TableColumn fx:id="colDuration"   text="Duration"      prefWidth="70"/>
                            <TableColumn fx:id="colStatus"     text="Status"        prefWidth="90"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="No records found." style="-fx-text-fill: #aaa;"/></placeholder>
                    </TableView>
                </StackPane>
            </VBox>
            <VBox fx:id="monthlySection" VBox.vgrow="ALWAYS" visible="false" managed="false" style="-fx-padding: 0 20 20 20;">
                <TableView fx:id="monthlyTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e8e8e8;">
                    <columns>
                        <TableColumn fx:id="colMonth"         text="Month"       prefWidth="110"/>
                        <TableColumn fx:id="colTotalRequests" text="Total"        prefWidth="80"/>
                        <TableColumn fx:id="colApproved"      text="Approved"     prefWidth="90"/>
                        <TableColumn fx:id="colRejected"      text="Rejected"     prefWidth="80"/>
                        <TableColumn fx:id="colPending"       text="Pending"      prefWidth="80"/>
                        <TableColumn fx:id="colMonthVisitors" text="Pass Slips"   prefWidth="80"/>
                        <TableColumn fx:id="colAvgDuration"   text="Avg Duration" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="No monthly records." style="-fx-text-fill: #aaa;"/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
