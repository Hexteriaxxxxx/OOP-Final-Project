<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox
        prefWidth="420.0"
        prefHeight="620.0"
        minHeight="620.0"
        maxHeight="620.0"
        alignment="TOP_CENTER"
        spacing="10.0"
        style="-fx-background-color: #ffffff;"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="main.controllers.StaffResetPasswordController">

    <padding>
        <Insets top="25.0" right="30.0" bottom="25.0" left="30.0" />
    </padding>

    <!-- Icon Pill -->
    <VBox alignment="CENTER" prefHeight="55.0" maxWidth="Infinity"
          style="-fx-background-color: #fdf0f0; -fx-background-radius: 30;">
        <padding><Insets top="8" bottom="8"/></padding>
        <SVGPath content="M12 1C8.676 1 6 3.676 6 7v1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1h-2V7c0-3.324-2.676-6-6-6zm0 2c2.276 0 4 1.724 4 4v1H8V7c0-2.276 1.724-4 4-4zm0 9a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"
                 style="-fx-fill: #8B0000;" scaleX="1.1" scaleY="1.1" />
    </VBox>

    <!-- Title -->
    <Label text="Reset Password" alignment="CENTER" maxWidth="Infinity"
           style="-fx-text-fill: #8B0000; -fx-font-size: 16px; -fx-font-weight: bold;">
        <font><Font name="System Bold" size="16.0" /></font>
    </Label>

    <!-- Subtitle -->
    <Label text="Enter your new password below."
           wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"
           style="-fx-text-fill: #555555; -fx-font-size: 11px;">
        <font><Font name="System" size="11.0" /></font>
    </Label>

    <!-- New Password Field -->
    <VBox spacing="4.0" maxWidth="Infinity">
        <Label text="New Password"
               style="-fx-text-fill: #333333; -fx-font-size: 11px; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="11.0" /></font>
        </Label>
        <StackPane>
            <PasswordField fx:id="newPasswordField" promptText="Enter new password"
                           prefHeight="34.0" maxWidth="Infinity"
                           style="-fx-background-color: #f5f5f5; -fx-border-color: #dddddd;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-font-size: 11px; -fx-padding: 0 42 0 10;" />
            <TextField fx:id="newPasswordVisible" promptText="Enter new password"
                       prefHeight="34.0" maxWidth="Infinity" visible="false" managed="false"
                       style="-fx-background-color: #f5f5f5; -fx-border-color: #dddddd;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-font-size: 11px; -fx-padding: 0 42 0 10;" />
            <Button fx:id="toggleNewPassword" text="👁"
                    prefWidth="30.0" prefHeight="30.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;
                       -fx-font-size: 13px; -fx-border-color: transparent;"
                    onAction="#handleToggleNewPassword"
                    StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin><Insets right="4.0"/></StackPane.margin>
            </Button>
        </StackPane>

        <!-- Strength Bar -->
        <HBox fx:id="strengthBarBox" spacing="4.0" maxWidth="Infinity" visible="false" managed="false">
            <Rectangle fx:id="seg1" width="84" height="4" arcWidth="4" arcHeight="4" fill="#dddddd" />
            <Rectangle fx:id="seg2" width="84" height="4" arcWidth="4" arcHeight="4" fill="#dddddd" />
            <Rectangle fx:id="seg3" width="84" height="4" arcWidth="4" arcHeight="4" fill="#dddddd" />
            <Rectangle fx:id="seg4" width="84" height="4" arcWidth="4" arcHeight="4" fill="#dddddd" />
        </HBox>
        <Label fx:id="strengthLabel" text="" maxWidth="Infinity"
               style="-fx-font-size: 10px; -fx-font-weight: bold;" visible="false" managed="false">
            <font><Font name="System Bold" size="10.0"/></font>
        </Label>
    </VBox>

    <!-- Confirm Password Field -->
    <VBox spacing="4.0" maxWidth="Infinity">
        <Label text="Confirm Password"
               style="-fx-text-fill: #333333; -fx-font-size: 11px; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="11.0" /></font>
        </Label>
        <StackPane>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"
                           prefHeight="34.0" maxWidth="Infinity"
                           style="-fx-background-color: #f5f5f5; -fx-border-color: #dddddd;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-font-size: 11px; -fx-padding: 0 42 0 10;" />
            <TextField fx:id="confirmPasswordVisible" promptText="Confirm new password"
                       prefHeight="34.0" maxWidth="Infinity" visible="false" managed="false"
                       style="-fx-background-color: #f5f5f5; -fx-border-color: #dddddd;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-font-size: 11px; -fx-padding: 0 42 0 10;" />
            <Button fx:id="toggleConfirmPassword" text="👁"
                    prefWidth="30.0" prefHeight="30.0"
                    style="-fx-background-color: transparent; -fx-cursor: hand;
                       -fx-font-size: 13px; -fx-border-color: transparent;"
                    onAction="#handleToggleConfirmPassword"
                    StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin><Insets right="4.0"/></StackPane.margin>
            </Button>
        </StackPane>
        <Label fx:id="matchLabel" text="" maxWidth="Infinity"
               style="-fx-font-size: 10px;" visible="false" managed="false">
            <font><Font name="System" size="10.0"/></font>
        </Label>
    </VBox>

    <!-- Password Validation Checklist -->
    <VBox fx:id="checklistBox" spacing="3.0" maxWidth="Infinity"
          style="-fx-background-color: #f9f9f9; -fx-background-radius: 10;
               -fx-border-color: #eeeeee; -fx-border-radius: 10;"
          visible="false" managed="false">
        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>

        <Label text="Password must contain:"
               style="-fx-text-fill: #777777; -fx-font-size: 10px; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="10.0"/></font>
        </Label>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="checkLength" text="✗" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="At least 8 characters" style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
        </HBox>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="checkUpper" text="✗" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="At least 1 uppercase letter (A-Z)" style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
        </HBox>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="checkLower" text="✗" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="At least 1 lowercase letter (a-z)" style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
        </HBox>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="checkNumber" text="✗" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="At least 1 number (0-9)" style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
        </HBox>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="checkSpecial" text="✗" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="At least 1 special character (!@#$...)" style="-fx-text-fill: #555555; -fx-font-size: 10px;"/>
        </HBox>
    </VBox>

    <!-- Spacer -->
    <Region VBox.vgrow="ALWAYS" />

    <!-- Error Label -->
    <Label fx:id="errorLabel" text="" maxWidth="Infinity" wrapText="true"
           alignment="CENTER" style="-fx-text-fill: #cc0000; -fx-font-size: 10px;">
        <font><Font name="System" size="10.0" /></font>
    </Label>

    <!-- Buttons -->
    <VBox spacing="7.0" maxWidth="Infinity">
        <Button fx:id="enterButton" text="Enter"
                prefHeight="36.0" maxWidth="Infinity"
                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                   -fx-font-size: 12px; -fx-font-weight: bold;
                   -fx-background-radius: 25; -fx-cursor: hand;"
                onAction="#handleEnter">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
        <Button fx:id="cancelButton" text="Cancel"
                prefHeight="36.0" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #8B0000;
                   -fx-font-size: 12px; -fx-font-weight: bold;
                   -fx-border-color: #8B0000; -fx-border-radius: 25;
                   -fx-background-radius: 25; -fx-cursor: hand;"
                onAction="#handleCancel">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
    </VBox>

</VBox>