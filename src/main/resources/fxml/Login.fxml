<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.controllers.LoginController"
           fx:id="rootPane"
           prefWidth="1280" prefHeight="720">

    <Pane style="-fx-background-color: linear-gradient(to bottom right, #600000, #900000, #800000);"/>

    <VBox alignment="CENTER" spacing="0">

        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 20 0;">
            <StackPane>
                <Circle radius="36" fill="white" opacity="0.15"/>
                <Circle radius="32" fill="white"/>
                <Label text="🛡" style="-fx-font-size: 28px;"/>
            </StackPane>
            <Label text="Pass Slip Issuance"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Secure Login Portal"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);"/>
        </VBox>

        <VBox fx:id="loginCard" alignment="CENTER" spacing="16"
              style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 32 40 28 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 24, 0, 0, 6);"
              maxWidth="340" minWidth="320">

            <HBox alignment="CENTER" spacing="0"
                  style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 4;">
                <Button fx:id="staffTab" text="Staff" onAction="#handleStaffTab"
                        style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 36;"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="adminTab" text="Admin" onAction="#handleAdminTab"
                        style="-fx-background-color: transparent; -fx-text-fill: #888;
                               -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 36;"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Username" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextField fx:id="usernameField" promptText="Enter your username" onAction="#handleLogin"
                           style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 12; -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <StackPane>
                    <PasswordField fx:id="passwordField" promptText="Enter your password" onAction="#handleLogin"
                                   style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 10 40 10 12; -fx-font-size: 13px;"/>
                    <TextField fx:id="passwordVisible" promptText="Enter your password" onAction="#handleLogin"
                               style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 10 40 10 12; -fx-font-size: 13px;"
                               visible="false" managed="false"/>
                    <Button fx:id="btnTogglePassword" text="👁" onAction="#handleTogglePassword"
                            style="-fx-background-color: transparent; -fx-border-width: 0;
                                   -fx-font-size: 15px; -fx-cursor: hand; -fx-padding: 0;"
                            StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin><Insets right="10"/></StackPane.margin>
                    </Button>
                </StackPane>
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberMe" text="Remember me"
                          style="-fx-font-size: 12px; -fx-text-fill: #555;" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword"
                           style="-fx-font-size: 12px; -fx-text-fill: #8B0000; -fx-font-weight: bold; -fx-border-color: transparent; -fx-padding: 0;"
                           HBox.hgrow="NEVER"/>
            </HBox>

            <Button text="Sign In" onAction="#handleLogin" maxWidth="Infinity"
                    style="-fx-background-color: #8B0000; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                <Hyperlink text="Sign Up" onAction="#handleSignUp"
                           style="-fx-font-size: 12px; -fx-text-fill: #8B0000;
                                  -fx-font-weight: bold; -fx-border-color: transparent;"/>
            </HBox>

            <Label fx:id="lblPortalType" text="Staff Portal"
                   style="-fx-font-size: 11px; -fx-text-fill: #aaa;"
                   alignment="CENTER" maxWidth="Infinity"/>

        </VBox>

        <Label text="© 2026 Pass Slip Issuance System. All rights reserved."
               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6); -fx-padding: 20 0 0 0;"/>

    </VBox>
</StackPane>
