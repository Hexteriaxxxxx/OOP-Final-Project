<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane
    fx:id="rootPane"
    prefHeight="640.0"
    prefWidth="900.0"
    style="-fx-background-color: #5a5a5a;"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.controller.StaffForgotPasswordController">

    <!-- Page title label (top-left) -->
    <Label
        layoutX="80.0"
        layoutY="50.0"
        text="Forgot Password Staff"
        style="-fx-text-fill: #cccccc; -fx-font-size: 13px;">
        <font>
            <Font name="System" size="13.0" />
        </font>
    </Label>

    <!-- White card -->
    <VBox
        layoutX="80.0"
        layoutY="75.0"
        prefWidth="700.0"
        prefHeight="530.0"
        spacing="0.0"
        style="-fx-background-color: #ffffff;
               -fx-background-radius: 20;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 16, 0, 0, 4);">

        <padding>
            <Insets top="55.0" right="60.0" bottom="55.0" left="60.0" />
        </padding>

        <!-- Title -->
        <Label
            text="Forgot Password"
            style="-fx-text-fill: #8B0000;
                   -fx-font-size: 28px;
                   -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <!-- Subtitle -->
        <Label
            text="Enter your registered email and we'll send u verification code."
            wrapText="true"
            style="-fx-text-fill: #333333;
                   -fx-font-size: 14px;"
            prefWidth="580.0">
            <font>
                <Font name="System" size="14.0" />
            </font>
            <VBox.margin>
                <Insets bottom="35.0" />
            </VBox.margin>
        </Label>

        <!-- Email Address label -->
        <Label
            text="Email Address"
            style="-fx-text-fill: #111111;
                   -fx-font-size: 15px;
                   -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <!-- Email Field with icon wrapper -->
        <HBox
            alignment="CENTER_LEFT"
            prefWidth="580.0"
            prefHeight="52.0"
            spacing="12.0"
            style="-fx-background-color: #fdf0f0;
                   -fx-background-radius: 30;
                   -fx-border-color: #c0605060;
                   -fx-border-radius: 30;
                   -fx-border-width: 1.5;
                   -fx-padding: 0 18 0 18;">
            <VBox.margin>
                <Insets bottom="28.0" />
            </VBox.margin>

            <!-- Mail icon via SVGPath -->
            <SVGPath
                content="M2 4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v.5L12 13 2 4.5V4z
                         M2 6.868V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6.868l-10 8.6-10-8.6z"
                style="-fx-fill: #8B0000;"
                scaleX="0.85"
                scaleY="0.85" />

            <!-- Email TextField -->
            <TextField
                fx:id="emailField"
                promptText="Enter your email"
                prefHeight="50.0"
                prefWidth="520.0"
                style="-fx-background-color: transparent;
                       -fx-border-color: transparent;
                       -fx-font-size: 14px;
                       -fx-text-fill: #333333;
                       -fx-prompt-text-fill: #aaaaaa;
                       -fx-padding: 0;" />
        </HBox>

        <!-- Submit Button -->
        <Button
            fx:id="submitButton"
            text="Submit"
            prefWidth="580.0"
            prefHeight="54.0"
            style="-fx-background-color: #8B0000;
                   -fx-text-fill: white;
                   -fx-font-size: 16px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 30;
                   -fx-cursor: hand;"
            onAction="#handleSubmit">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <VBox.margin>
                <Insets bottom="20.0" />
            </VBox.margin>
        </Button>

        <!-- Back to Login -->
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label
                text="←"
                style="-fx-text-fill: #8B0000; -fx-font-size: 15px;" />
            <Hyperlink
                fx:id="backToLoginLink"
                text="Back to Login"
                style="-fx-text-fill: #8B0000;
                       -fx-font-size: 14px;
                       -fx-border-color: transparent;
                       -fx-underline: false;
                       -fx-cursor: hand;"
                onAction="#handleBackToLogin">
                <font>
                    <Font name="System" size="14.0" />
                </font>
            </Hyperlink>
        </HBox>

    </VBox>

</AnchorPane>
