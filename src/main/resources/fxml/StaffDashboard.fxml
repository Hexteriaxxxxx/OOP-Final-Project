<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controllers.StaffDashboardController"
            prefWidth="1100" prefHeight="780"
            style="-fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-background-color: #F4F6F9;">

    <left>
        <VBox prefWidth="160" spacing="0"
              style="-fx-background-color: linear-gradient(to bottom, #8B0000, #5A0000); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 12, 0, 3, 0);">
            <VBox spacing="4" alignment="CENTER_LEFT"
                  style="-fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 0 0 1 0;">
                <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" minWidth="36" minHeight="36" style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 8;">
                        <Label text="PS" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="Pass Slip" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label text="Issuance System" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="15" right="10" bottom="15" left="10"/></padding>
                <Button fx:id="btnDashboard" text="  ⊞  Dashboard"          maxWidth="Infinity" onAction="#handleDashboard"        style="-fx-background-color: rgba(255,255,255,0.22); -fx-text-fill: white; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button fx:id="btnPassSlip"  text="  📋  Pass Slip Issuance" maxWidth="Infinity" onAction="#handlePassSlipIssuance" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button fx:id="btnVisitor"   text="  👤  Visitor Module"     maxWidth="Infinity" onAction="#handleVisitorModule"    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"/>
                <Button fx:id="btnReports"   text="  📊  Reports"            maxWidth="Infinity" onAction="#handleReports"          style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12.5px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"/>
            </VBox>
            <VBox spacing="8" style="-fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 1 0 0 0;">
                <padding><Insets top="10" right="10" bottom="15" left="10"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 8;">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <VBox alignment="CENTER" minWidth="32" minHeight="32" style="-fx-background-color: rgba(255,255,255,0.25); -fx-background-radius: 16;">
                        <Label text="S" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label fx:id="lblUserName" text="Staff" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblUserRole" text="Staff" style="-fx-text-fill: rgba(255,255,255,0.60); -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
                <Button text="  ↪  Logout" maxWidth="Infinity" onAction="#handleLogout"
                        style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12.5px; -fx-padding: 9 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 8; -fx-border-width: 1; -fx-alignment: CENTER_LEFT;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #F4F6F9;" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: white; -fx-border-color: #E8ECF0; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                <padding><Insets top="14" right="20" bottom="12" left="20"/></padding>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Dashboard" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    <Label fx:id="lblWelcome" text="Welcome back, Staff" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                </VBox>
                <!-- 🔔 Bell button -->
                <Button fx:id="btnNotification" text="🔔" onAction="#handleNotification"
                        style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #888; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 4;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="14">
                    <padding><Insets top="14" right="20" bottom="20" left="20"/></padding>

                    <HBox spacing="12">
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                            <HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Pending Requests" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblPending" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;"/></VBox><Label text="⏳" style="-fx-font-size: 22px; -fx-text-fill: #E67E00;"/></HBox>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                            <HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Approved Requests" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblApproved" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/></VBox><Label text="✅" style="-fx-font-size: 22px;"/></HBox>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                            <HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Rejected Requests" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblRejected" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/></VBox><Label text="❌" style="-fx-font-size: 22px;"/></HBox>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                            <HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Active Pass Slips Today" style="-fx-font-size: 11px; -fx-text-fill: #888;"/><Label fx:id="lblActive" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/></VBox><Label text="📋" style="-fx-font-size: 22px;"/></HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="12" VBox.vgrow="ALWAYS">
                        <VBox HBox.hgrow="ALWAYS" spacing="10" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Pass Slip Requests" HBox.hgrow="ALWAYS" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Button text="+ Create Pass Slip" onAction="#handleCreatePassSlip"
                                        style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 14; -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="txtSearch" promptText="🔍  Search..." HBox.hgrow="ALWAYS" onKeyReleased="#handleSearch"
                                           style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 7 12; -fx-font-size: 12.5px;"/>
                                <ComboBox fx:id="cmbFilter" prefWidth="110" onAction="#handleFilter"
                                          style="-fx-background-radius: 20; -fx-border-color: #ddd; -fx-background-color: white;"/>
                            </HBox>
                            <TableView fx:id="tblPassSlips" VBox.vgrow="ALWAYS" minHeight="280"
                                       style="-fx-background-color: white; -fx-border-color: #e8e8e8;">
                                <columns>
                                    <TableColumn fx:id="colRequestId"  text="Request ID"  prefWidth="90"/>
                                    <TableColumn fx:id="colName"       text="Name"        prefWidth="100"/>
                                    <TableColumn fx:id="colDepartment" text="Department"  prefWidth="110"/>
                                    <TableColumn fx:id="colPurpose"    text="Purpose"     prefWidth="120"/>
                                    <TableColumn fx:id="colTimeOut"    text="Time Out"    prefWidth="80"/>
                                    <TableColumn fx:id="colTimeIn"     text="Time In"     prefWidth="80"/>
                                    <TableColumn fx:id="colStatus"     text="Status"      prefWidth="90"/>
                                    <TableColumn fx:id="colActions"    text="Actions"     prefWidth="70"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <placeholder><Label text="No pass slip records found." style="-fx-text-fill: #aaa;"/></placeholder>
                            </TableView>
                        </VBox>

                        <VBox spacing="12" prefWidth="220">
                            <VBox spacing="8" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                                <Label text="🔔  Notifications" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <VBox fx:id="notifContainer" spacing="5">
                                    <Label text="No notifications." style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                                </VBox>
                            </VBox>
                            <VBox spacing="8" VBox.vgrow="ALWAYS" style="-fx-background-color: #f8f8f8; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #ececec; -fx-border-radius: 10; -fx-border-width: 1;">
                                <Label text="🕐  Recent Activity" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <VBox fx:id="activityContainer" spacing="6">
                                    <Label text="No recent activity." style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                                </VBox>
                            </VBox>
                            <VBox spacing="8" style="-fx-background-color: #8B0000; -fx-background-radius: 10; -fx-padding: 12 14;">
                                <Label text="📅  Today's Summary" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                                <HBox alignment="CENTER_LEFT"><Label text="Total Requests" HBox.hgrow="ALWAYS" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12px;"/><Label fx:id="lblTotalRequests" text="0" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Approval Rate"  HBox.hgrow="ALWAYS" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12px;"/><Label fx:id="lblApprovalRate"  text="0%" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
                                <HBox alignment="CENTER_LEFT"><Label text="Active Now"     HBox.hgrow="ALWAYS" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12px;"/><Label fx:id="lblActiveNow"     text="0" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
