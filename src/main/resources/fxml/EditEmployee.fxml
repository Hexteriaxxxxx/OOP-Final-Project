<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controllers.EditEmployeeController"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-pref-width: 500px;"
      spacing="0">

    <HBox style="-fx-padding: 18 20 14 20; -fx-alignment: CENTER_LEFT;">
        <Label text="Edit Employee"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕" onAction="#handleClose"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                       -fx-font-size: 16px; -fx-cursor: hand; -fx-border-color: transparent;"/>
    </HBox>

    <VBox style="-fx-padding: 0 20 14 20;" spacing="12">

        <!-- Full Name -->
        <VBox spacing="5">
            <Label text="Full Name *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextField fx:id="tfFullName" promptText="Employee full name"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #fca5a5; -fx-padding: 8 12; -fx-font-size: 12.5px;"/>
        </VBox>

        <!-- Department dropdown -->
        <VBox spacing="5">
            <Label text="Department *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <ComboBox fx:id="cbDepartment" promptText="Select department..."
                      maxWidth="Infinity" onAction="#handleDepartmentChange"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #fca5a5; -fx-font-size: 12.5px; -fx-padding: 4 8;"/>
            <TextField fx:id="tfCustomDept" promptText="Enter new department name..."
                       visible="false" managed="false"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #fca5a5; -fx-padding: 8 12; -fx-font-size: 12.5px;"/>
        </VBox>

        <!-- Position dropdown -->
        <VBox spacing="5">
            <Label text="Position *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <ComboBox fx:id="cbPosition" promptText="Select position..."
                      maxWidth="Infinity" onAction="#handlePositionChange"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #fca5a5; -fx-font-size: 12.5px; -fx-padding: 4 8;"/>
            <TextField fx:id="tfCustomPosition" promptText="Enter new position title..."
                       visible="false" managed="false"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #fca5a5; -fx-padding: 8 12; -fx-font-size: 12.5px;"/>
        </VBox>

    </VBox>

    <HBox style="-fx-padding: 14 20 14 20; -fx-alignment: CENTER_RIGHT;
                 -fx-border-color: #e5e7eb; -fx-border-width: 0.5 0 0 0;" spacing="10">
        <Button text="Cancel" onAction="#handleClose"
                style="-fx-background-color: white; -fx-text-fill: #374151;
                       -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-padding: 8 18; -fx-font-size: 13px; -fx-cursor: hand;"/>
        <Button text="💾  Save Changes" onAction="#handleSave"
                style="-fx-background-color: #7f1d1d; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-border-radius: 6;
                       -fx-padding: 8 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>
