<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controllers.CreatePassSlipController"
      spacing="14" prefWidth="420"
      style="-fx-background-color: white; -fx-padding: 24;">

    <Label text="Create Pass Slip Request"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

    <Label text="Employee Name" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
    <ComboBox fx:id="cmbEmployee" promptText="Select employee"
              maxWidth="Infinity"
              style="-fx-background-color: white; -fx-border-color: #ddd;
                     -fx-border-radius: 6; -fx-background-radius: 6;"/>

    <Label text="Department" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
    <TextField fx:id="txtDepartment" promptText="Auto-filled"
               editable="false"
               style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd;
                      -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

    <Label text="Purpose" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
    <TextArea fx:id="txtPurpose" promptText="Enter reason for pass slip"
              prefHeight="80" wrapText="true"
              style="-fx-background-color: white; -fx-border-color: #ddd;
                     -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Time Out" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
            <TextField fx:id="txtTimeOut" promptText="HH:MM (e.g. 09:30)"
                       style="-fx-background-color: white; -fx-border-color: #ddd;
                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Time In (optional)" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
            <TextField fx:id="txtTimeIn" promptText="HH:MM (optional)"
                       style="-fx-background-color: white; -fx-border-color: #ddd;
                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
        </VBox>
    </HBox>

    <Label fx:id="lblError" text=""
           style="-fx-text-fill: #dc3545; -fx-font-size: 11px;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333;
                       -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="  📋  Submit Request" onAction="#handleSubmit"
                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>
