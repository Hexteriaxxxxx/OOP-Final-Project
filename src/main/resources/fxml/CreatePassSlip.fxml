<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controllers.CreatePassSlipController"
      spacing="12" prefWidth="480"
      style="-fx-background-color: white; -fx-padding: 0 0 20 0; -fx-background-radius: 12;">

    <!-- Title Bar -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 16 18 14 18; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
        <Label text="Create Pass Slip Request" HBox.hgrow="ALWAYS"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        <Button text="✕" onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #999;
                       -fx-font-size: 13px; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 2 6;"/>
    </HBox>

    <!-- Form Body -->
    <VBox spacing="10" style="-fx-padding: 10 18 0 18;">

        <!-- Employee Name -->
        <Label text="Employee Name *"
               style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <VBox spacing="0">
            <TextField fx:id="txtEmployee" promptText="Type employee name..."
                       style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14;"/>
            <ListView fx:id="lstSuggestions"
                      style="-fx-background-color: white; -fx-border-color: #E8C0C0;
                             -fx-border-width: 0 1 1 1; -fx-border-radius: 0 0 8 8;
                             -fx-background-radius: 0 0 8 8; -fx-font-size: 12px;"
                      prefHeight="0"/>
        </VBox>

        <!-- Department -->
        <Label text="Department"
               style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <TextField fx:id="txtDepartment" promptText="Auto-filled when employee is selected"
                   editable="false"
                   style="-fx-background-color: #F5F5F5; -fx-border-color: #D0D0D0;
                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14; -fx-text-fill: #666;"/>

        <!-- Category -->
        <Label text="Category *"
               style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <ComboBox fx:id="cmbCategory" promptText="Select category..." maxWidth="Infinity"
                  onAction="#handleCategoryChange"
                  style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                         -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 10;
                         -fx-font-size: 12.5px;"/>

        <!-- Purpose -->
        <Label text="Purpose *"
               style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <TextArea fx:id="txtPurpose" promptText="Enter reason for pass slip"
                  prefHeight="75" wrapText="true"
                  style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                         -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>

        <!-- Date -->
        <Label text="Date"
               style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <TextField fx:id="txtDate" editable="false"
                   style="-fx-background-color: #F5F5F5; -fx-border-color: #D0D0D0;
                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14; -fx-text-fill: #666;"/>

        <!-- Time Out and Time In -->
        <HBox spacing="14">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Time Out *"
                       style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <Button fx:id="btnTimeOut" onAction="#handlePickTimeOut" maxWidth="Infinity"
                        style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                               -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14;
                               -fx-font-size: 12.5px; -fx-cursor: hand; -fx-text-fill: #333;
                               -fx-alignment: CENTER_LEFT; -fx-border-width: 1;"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Time In *"
                       style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <Button fx:id="btnTimeIn" onAction="#handlePickTimeIn" maxWidth="Infinity"
                        style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                               -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14;
                               -fx-font-size: 12.5px; -fx-cursor: hand; -fx-text-fill: #333;
                               -fx-alignment: CENTER_LEFT; -fx-border-width: 1;"/>
            </VBox>
        </HBox>

        <!-- Note -->
        <VBox style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;">
            <Label text="Note: Pass slip request will be sent for approval. You will be notified once approved or rejected."
                   wrapText="true"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #8B0000;"/>
        </VBox>

        <!-- Error -->
        <Label fx:id="lblError" text=""
               style="-fx-text-fill: #dc3545; -fx-font-size: 11px;" wrapText="true"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 6 18 0 18;">
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: white; -fx-text-fill: #555;
                       -fx-font-size: 12px; -fx-padding: 9 26; -fx-background-radius: 20;
                       -fx-border-color: #ccc; -fx-border-radius: 20; -fx-cursor: hand;"/>
        <Button fx:id="btnSubmit" text="📋  Submit Request" onAction="#handleSubmit"
                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-padding: 9 26; -fx-background-radius: 20;
                       -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>

</VBox>
