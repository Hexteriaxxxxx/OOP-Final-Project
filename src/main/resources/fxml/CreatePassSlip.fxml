<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    CreatePassSlip.fxml
    Layout: Title (fixed) → ScrollPane with form → Buttons (fixed)
    Fits ANY resolution — buttons always visible, form scrolls if needed
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controllers.CreatePassSlipController"
      prefWidth="460" maxWidth="460"
      style="-fx-background-color: white; -fx-background-radius: 12;">

    <!-- ── TITLE BAR (always visible) ──────────────────────────── -->
    <HBox alignment="CENTER_LEFT" minHeight="50"
          style="-fx-padding: 14 18 12 18;
                 -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;
                 -fx-background-color: white; -fx-background-radius: 12 12 0 0;">
        <Label text="Create Pass Slip Request" HBox.hgrow="ALWAYS"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        <Button text="✕" onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #999;
                       -fx-font-size: 13px; -fx-cursor: hand; -fx-border-width: 0; -fx-padding: 2 6;"/>
    </HBox>

    <!-- ── SCROLLABLE FORM BODY ──────────────────────────────────── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="8" style="-fx-padding: 12 18 8 18; -fx-background-color: white;">

            <!-- Employee Name -->
            <Label text="Employee Name *"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <VBox spacing="0">
                <TextField fx:id="txtEmployee" promptText="Type employee name..."
                           style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;
                                  -fx-font-size: 12px;"/>
                <ListView fx:id="lstSuggestions"
                          style="-fx-background-color: white; -fx-border-color: #E8C0C0;
                                 -fx-border-width: 0 1 1 1; -fx-border-radius: 0 0 8 8;
                                 -fx-background-radius: 0 0 8 8; -fx-font-size: 12px;"
                          prefHeight="0"/>
            </VBox>

            <!-- Department -->
            <Label text="Department"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <TextField fx:id="txtDepartment" promptText="Auto-filled when employee is selected"
                       editable="false"
                       style="-fx-background-color: #F5F5F5; -fx-border-color: #D0D0D0;
                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;
                              -fx-text-fill: #666; -fx-font-size: 12px;"/>

            <!-- Category -->
            <Label text="Category *"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbCategory" promptText="Select category..."
                      maxWidth="Infinity" onAction="#handleCategoryChange"
                      style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                             -fx-border-radius: 8; -fx-background-radius: 8;
                             -fx-padding: 3 10; -fx-font-size: 12px;"/>

            <!-- Purpose -->
            <Label text="Purpose *"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <TextArea fx:id="txtPurpose" promptText="Enter reason for pass slip"
                      prefHeight="60" wrapText="true"
                      style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                             -fx-border-radius: 8; -fx-background-radius: 8;
                             -fx-padding: 7 10; -fx-font-size: 12px;"/>

            <!-- Date -->
            <Label text="Date"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <TextField fx:id="txtDate" editable="false"
                       style="-fx-background-color: #F5F5F5; -fx-border-color: #D0D0D0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 8 12; -fx-text-fill: #666; -fx-font-size: 12px;"/>

            <!-- Time Out -->
            <Label text="Time Out *"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
            <Button fx:id="btnTimeOut" onAction="#handlePickTimeOut" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                           -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;
                           -fx-font-size: 12px; -fx-cursor: hand; -fx-text-fill: #333;
                           -fx-alignment: CENTER_LEFT; -fx-border-width: 1;"/>

            <!-- Expected Time In -->
            <Label text="Expected Time In *"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #555; -fx-font-weight: bold;"/>

            <!-- Quick presets -->
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Quick:" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                <Button fx:id="btn30min"   text="30 min"   onAction="#handlePreset30m"
                        style="-fx-background-color: white; -fx-border-color: #E8C0C0; -fx-border-width: 1;
                               -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 10.5px;
                               -fx-padding: 3 8; -fx-cursor: hand; -fx-text-fill: #8B0000;"/>
                <Button fx:id="btn1hr"    text="1 hr"     onAction="#handlePreset1h"
                        style="-fx-background-color: white; -fx-border-color: #E8C0C0; -fx-border-width: 1;
                               -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 10.5px;
                               -fx-padding: 3 8; -fx-cursor: hand; -fx-text-fill: #8B0000;"/>
                <Button fx:id="btn2hr"    text="2 hrs"    onAction="#handlePreset2h"
                        style="-fx-background-color: white; -fx-border-color: #E8C0C0; -fx-border-width: 1;
                               -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 10.5px;
                               -fx-padding: 3 8; -fx-cursor: hand; -fx-text-fill: #8B0000;"/>
                <Button fx:id="btnHalfDay" text="Half day" onAction="#handlePresetHalfDay"
                        style="-fx-background-color: white; -fx-border-color: #E8C0C0; -fx-border-width: 1;
                               -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 10.5px;
                               -fx-padding: 3 8; -fx-cursor: hand; -fx-text-fill: #8B0000;"/>
            </HBox>

            <!-- Time In manual picker -->
            <Button fx:id="btnTimeIn" onAction="#handlePickTimeIn" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                           -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;
                           -fx-font-size: 12px; -fx-cursor: hand; -fx-text-fill: #333;
                           -fx-alignment: CENTER_LEFT; -fx-border-width: 1;"/>

            <!-- Note -->
            <VBox style="-fx-background-color: #FFF0F0; -fx-border-color: #E8C0C0;
                         -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;">
                <Label text="Note: Pass slip request will be sent for approval."
                       wrapText="true"
                       style="-fx-font-size: 11px; -fx-text-fill: #8B0000;"/>
            </VBox>

            <!-- Error label -->
            <Label fx:id="lblError" text=""
                   style="-fx-text-fill: #dc3545; -fx-font-size: 11px;" wrapText="true"/>

        </VBox>
    </ScrollPane>

    <!-- ── BUTTONS (always fixed at bottom — NEVER scrolls away) ── -->
    <HBox spacing="10" alignment="CENTER_RIGHT" minHeight="52"
          style="-fx-padding: 10 18 12 18;
                 -fx-border-color: #e8e8e8; -fx-border-width: 1 0 0 0;
                 -fx-background-color: white; -fx-background-radius: 0 0 12 12;">
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: white; -fx-text-fill: #555;
                       -fx-font-size: 12px; -fx-padding: 8 22;
                       -fx-background-radius: 20; -fx-border-color: #ccc;
                       -fx-border-radius: 20; -fx-cursor: hand;"/>
        <Button fx:id="btnSubmit" text="📋  Submit Request" onAction="#handleSubmit"
                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-padding: 8 22;
                       -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>

</VBox>
