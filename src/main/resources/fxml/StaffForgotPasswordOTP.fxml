<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<VBox
        prefWidth="420.0"
        prefHeight="380.0"
        alignment="CENTER"
        spacing="14.0"
        style="-fx-background-color: #ffffff;
           -fx-background-radius: 16;
           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 6);"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="main.controllers.StaffForgotPasswordOTPController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>

    <VBox alignment="CENTER" prefHeight="65.0" maxWidth="Infinity"
          style="-fx-background-color: #fdf0f0; -fx-background-radius: 35;">
        <padding><Insets top="10" bottom="10"/></padding>
        <SVGPath content="M12 1C8.676 1 6 3.676 6 7v1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1h-2V7c0-3.324-2.676-6-6-6zm0 2c2.276 0 4 1.724 4 4v1H8V7c0-2.276 1.724-4 4-4zm0 9a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"
                 style="-fx-fill: #8B0000;" scaleX="1.2" scaleY="1.2" />
    </VBox>

    <Label text="Enter Verification Code" alignment="CENTER" maxWidth="Infinity"
           style="-fx-text-fill: #8B0000; -fx-font-size: 17px; -fx-font-weight: bold;">
        <font><Font name="System Bold" size="17.0" /></font>
    </Label>

    <Label fx:id="subtitleLabel" text="Enter the 6-digit code sent to your email address."
           wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"
           style="-fx-text-fill: #555555; -fx-font-size: 11px;">
        <font><Font name="System" size="11.0" /></font>
    </Label>

    <VBox spacing="5.0" maxWidth="Infinity">
        <Label text="Verification Code"
               style="-fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="12.0" /></font>
        </Label>
        <TextField fx:id="otpField" promptText="Enter 6-digit code"
                   prefHeight="38.0" maxWidth="Infinity"
                   style="-fx-background-color: #f5f5f5; -fx-border-color: #dddddd;
                   -fx-border-radius: 8; -fx-background-radius: 8;
                   -fx-font-size: 16px; -fx-alignment: center;
                   -fx-padding: 0 10 0 10;" />
    </VBox>

    <Label fx:id="errorLabel" text="" maxWidth="Infinity" wrapText="true"
           alignment="CENTER" style="-fx-text-fill: #cc0000; -fx-font-size: 11px;">
        <font><Font name="System" size="11.0" /></font>
    </Label>

    <VBox spacing="8.0" maxWidth="Infinity">
        <Button fx:id="submitButton" text="Submit Code"
                prefHeight="38.0" maxWidth="Infinity"
                style="-fx-background-color: #8B0000; -fx-text-fill: white;
                   -fx-font-size: 12px; -fx-font-weight: bold;
                   -fx-background-radius: 25; -fx-cursor: hand;"
                onAction="#handleSubmit">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
        <Button fx:id="backButton" text="Back"
                prefHeight="38.0" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #8B0000;
                   -fx-font-size: 12px; -fx-font-weight: bold;
                   -fx-border-color: #8B0000; -fx-border-radius: 25;
                   -fx-background-radius: 25; -fx-cursor: hand;"
                onAction="#handleBack">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
    </VBox>

</VBox>