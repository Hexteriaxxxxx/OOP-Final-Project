<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<VBox
        prefWidth="300.0"
        alignment="CENTER"
        spacing="12.0"
        style="-fx-background-color: #ffffff;
           -fx-background-radius: 16;
           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 6);"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.controller.StaffForgotPasswordSuccessController">

    <padding>
        <Insets top="24.0" right="20.0" bottom="24.0" left="20.0" />
    </padding>

    <!-- Pink pill - envelope -->
    <VBox
            alignment="CENTER"
            prefHeight="65.0"
            maxWidth="Infinity"
            style="-fx-background-color: #fdf0f0;
               -fx-background-radius: 35;">
        <SVGPath
                content="M2 4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v.5L12 13 2 4.5V4z M2 6.868V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6.868l-10 8.6-10-8.6z"
                style="-fx-fill: #8B0000;"
                scaleX="1.3"
                scaleY="1.3" />
    </VBox>

    <!-- Dark red pill - checkmark -->
    <VBox
            alignment="CENTER"
            prefHeight="42.0"
            maxWidth="Infinity"
            style="-fx-background-color: #8B0000;
               -fx-background-radius: 35;">
        <SVGPath
                content="M5 13l4 4L19 7"
                style="-fx-stroke: white;
                   -fx-stroke-width: 2.5;
                   -fx-fill: transparent;"
                scaleX="1.0"
                scaleY="1.0" />
    </VBox>

    <!-- Title -->
    <Label
            text="Check Your Email"
            alignment="CENTER"
            maxWidth="Infinity"
            style="-fx-text-fill: #8B0000;
               -fx-font-size: 15px;
               -fx-font-weight: bold;">
        <font>
            <Font name="System Bold" size="15.0" />
        </font>
    </Label>

    <!-- Message -->
    <Label
            fx:id="messageLabel"
            text="A password reset link has been sent to your email address. Please check your inbox and follow the instructions."
            wrapText="true"
            alignment="CENTER"
            textAlignment="CENTER"
            maxWidth="Infinity"
            style="-fx-text-fill: #555555; -fx-font-size: 11px;">
        <font>
            <Font name="System" size="11.0" />
        </font>
    </Label>

    <!-- Hint -->
    <Label
            text="Didn't receive an email? Check your spam folder or try again."
            wrapText="true"
            alignment="CENTER"
            textAlignment="CENTER"
            maxWidth="Infinity"
            style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;">
        <font>
            <Font name="System" size="10.0" />
        </font>
    </Label>

    <!-- Back to Login Button -->
    <Button
            fx:id="backToLoginButton"
            text="Back to Login"
            prefHeight="38.0"
            maxWidth="Infinity"
            style="-fx-background-color: #8B0000;
               -fx-text-fill: white;
               -fx-font-size: 12px;
               -fx-font-weight: bold;
               -fx-background-radius: 25;
               -fx-cursor: hand;"
            onAction="#handleBackToLogin">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</VBox>